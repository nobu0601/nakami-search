{
  "name": "nakami-search",
  "productName": "なかみ検索",
  "version": "1.0.0",
  "description": "ファイル名と中身をまとめて検索するデスクトップアプリ",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist:win": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "chokidar": "3.6.0",
    "mammoth": "1.8.0",
    "pdfjs-dist": "3.11.174",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "local.nakami-search",
    "productName": "なかみ検索",
    "artifactName": "nakami-search-setup-${version}.${ext}",
    "files": [
      "src/**/*",
      "package.json",
      "!**/node_modules/canvas/**"
    ],
    "asarUnpack": [
      "node_modules/pdfjs-dist/cmaps/**",
      "node_modules/pdfjs-dist/standard_fonts/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "なかみ検索"
    },
    "npmRebuild": false
  }
}
