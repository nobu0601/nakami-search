{
  "name": "nakami-search",
  "productName": "なかみ検索",
  "version": "1.1.0",
  "description": "ファイル名と中身をまとめて検索するデスクトップアプリ",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist:win": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/jpn": "^1.0.0",
    "chokidar": "3.6.0",
    "electron-updater": "^6.3.9",
    "jszip": "^3.10.1",
    "mammoth": "1.8.0",
    "pdfjs-dist": "3.11.174",
    "pngjs": "^7.0.0",
    "tesseract.js": "^5.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "local.nakami-search",
    "productName": "なかみ検索",
    "artifactName": "nakami-search-setup-${version}.${ext}",
    "files": [
      "src/**/*",
      "package.json",
      "!**/node_modules/canvas/**",
      "!**/node_modules/@tesseract.js-data/*/4.0.0/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "なかみ検索"
    },
    "npmRebuild": false,
    "asar": false,
    "publish": [
      {
        "provider": "github",
        "owner": "nobu0601",
        "repo": "nakami-search"
      }
    ]
  }
}
